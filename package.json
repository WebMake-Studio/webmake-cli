{
  "name": "webmake-cli",
  "version": "2.0.0",
  "description": "WebMake CLI - a zero-dependency static dev server with live reload, SPA fallback and universal redirect support (_redirects, netlify.toml, vercel.json, firebase.json, staticwebapp.config.json, .htaccess).",
  "keywords": [
    "webmake",
    "dev-server",
    "static-server",
    "live-reload",
    "redirects",
    "_redirects",
    "netlify",
    "spa",
    "cli"
  ],
  "author": "Rafael ISTE",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/WebMake-Studio/webmake-cli.git"
  },
  "homepage": "https://github.com/WebMake-Studio/webmake-cli#readme",
  "bugs": {
    "url": "https://github.com/WebMake-Studio/webmake-cli/issues"
  },
  "bin": {
    "webmake": "bin/webmake.js",
    "webmake-cli": "bin/webmake.js"
  },
  "main": "src/index.js",
  "files": [
    "bin",
    "src",
    "docs",
    "examples",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18.17.0"
  },
  "scripts": {
    "start": "node bin/webmake.js dev",
    "demo": "node bin/webmake.js dev examples/demo-site",
    "test": "node test/run.js",
    "prepublishOnly": "npm test"
  },
  "dependencies": {},
  "devDependencies": {}
}
